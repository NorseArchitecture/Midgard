<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Norse.Infrastructure.Web.Server.Generator: discovers Norse gRPC contracts ([ServiceContract] interfaces named I{Context}Service with >=1 Task&lt;Outcome&lt;T&gt;&gt;/ValueTask&lt;Outcome&lt;T&gt;&gt; method) and their implementations at compile time and emits MapNorseGrpcServices() — code-first MapGrpcService/EnableGrpcWeb registration plus idempotent Outcome&lt;T&gt; surrogate wiring against RuntimeTypeModel.Default. Also discovers FluentValidation validators and Blazor-routable assemblies, emitting AddNorseClientComponents() — idempotent validator registration plus a RoutesAdditionalAssemblies singleton — and AddNorseComponentAssemblies() — an AddAdditionalAssemblies extension on RazorComponentsEndpointConventionBuilder feeding Razor endpoint discovery, both when Yggdrasil's routing composition seam is present. The Xml/ subfolder walks facade-controller (GrpcControllerBase descendant) action closures across the host compilation and its reference closure — realm-resident controllers emit into whatever host references them — request closure from body-bound parameter types, response closure from ActionResult&lt;T&gt; payload types — enforces Futhark's XML shape law at build time (NORSE022-028), and emits one internal sealed {Contract}XmlShape : IXmlShape&lt;{Contract}&gt; class per contract (reader, writer, registration) via NorseXmlShapeRegistration.Build(). Bundled into Infrastructure.Web.Server's package (analyzers/dotnet/cs/), never referenced or packed standalone.</Description>
	</PropertyGroup>
	<ItemGroup>
		<NorseRef Include="Abstractions.Emit">
			<Repo>Asgard</Repo>
		</NorseRef>
		<Compile Include="../Infrastructure.Web.Grpc.Generator.Shared/ContractDiscovery.cs" Link="Shared/ContractDiscovery.cs" />
		<Compile Include="../Infrastructure.Web.Grpc.Generator.Shared/ComponentDiscovery.cs" Link="Shared/ComponentDiscovery.cs" />
		<Compile Include="../Infrastructure.Web.Grpc.Generator.Shared/RootNamespaceResolution.cs" Link="Shared/RootNamespaceResolution.cs" />
	</ItemGroup>
</Project>
