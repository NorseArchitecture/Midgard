<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Norse.Infrastructure.Web.Client.Generator: discovers Norse gRPC contracts ([ServiceContract] interfaces named I{Context}Service with >=1 Task&lt;Outcome&lt;T&gt;&gt;/ValueTask&lt;Outcome&lt;T&gt;&gt; method) at compile time and emits AddNorseGrpcClients() — code-first CreateGrpcService proxy registration over an OutcomeClientInterceptor-decorated invoker, plus idempotent Outcome&lt;T&gt; surrogate wiring against RuntimeTypeModel.Default. Also discovers FluentValidation validators and Blazor-routable assemblies, emitting AddNorseClientComponents() — idempotent validator registration plus a RoutesAdditionalAssemblies singleton when Yggdrasil's routing composition seam is present. Also discovers [NorsePolicy] declarations across the reference set and emits AddNorsePolicies() — the same registration the server generator emits (shared discovery and emitter, NORSE014/NORSE015 alike), bootstrapped WASM-safe from AddAuthorizationCore() instead of the shared-framework-only AddAuthorizationBuilder(). Bundled into Infrastructure.Web.Client's package (analyzers/dotnet/cs/), never referenced or packed standalone.</Description>
	</PropertyGroup>
	<ItemGroup>
		<NorseRef Include="Abstractions.Emit">
			<Repo>Asgard</Repo>
		</NorseRef>
		<Compile Include="../Infrastructure.Web.Grpc.Generator.Shared/ComponentDiscovery.cs" Link="Shared/ComponentDiscovery.cs" />
		<Compile Include="../Infrastructure.Web.Grpc.Generator.Shared/ContractDiscovery.cs" Link="Shared/ContractDiscovery.cs" />
		<Compile Include="../Infrastructure.Web.Grpc.Generator.Shared/RootNamespaceResolution.cs" Link="Shared/RootNamespaceResolution.cs" />
		<Compile Include="../Infrastructure.Web.Server.Generator/Diagnostics.cs" Link="Policies/Diagnostics.cs" />
		<Compile Include="../Infrastructure.Web.Server.Generator/Policies/PolicyDeclarationDiscovery.cs" Link="Policies/PolicyDeclarationDiscovery.cs" />
		<Compile Include="../Infrastructure.Web.Server.Generator/Policies/PolicyRegistrationEmitter.cs" Link="Policies/PolicyRegistrationEmitter.cs" />
	</ItemGroup>
</Project>
