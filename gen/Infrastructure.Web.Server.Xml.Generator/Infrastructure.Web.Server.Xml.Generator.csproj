<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Norse.Infrastructure.Web.Server.Xml.Generator: walks facade-controller (GrpcControllerBase descendant) action closures in the host compilation — request closure from body-bound parameter types, response closure from ActionResult&lt;T&gt; payload types — enforces Futhark's XML shape law at build time (NORSE022-028), and emits one internal sealed {Contract}XmlShape : IXmlShape&lt;{Contract}&gt; class per contract (reader, writer, registration) via NorseXmlShapeRegistration.Build(). Bundled into Infrastructure.Web.Server's package (analyzers/dotnet/cs/), never referenced or packed standalone.</Description>
	</PropertyGroup>
	<ItemGroup>
		<NorseRef Include="Abstractions.Emit">
			<Repo>Asgard</Repo>
		</NorseRef>
	</ItemGroup>
</Project>
