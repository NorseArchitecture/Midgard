<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<Description>Norse.Infrastructure.Web.Server: gRPC server-side failure encoding. Mediator/Grpc translates Problem into google.rpc.Status + ErrorInfo/BadRequest/DebugInfo well-known types on a grpc-status-details-bin trailer, paired with Infrastructure.Web.Client for symmetrical decoding.</Description>
	</PropertyGroup>
	<ItemGroup>
		<NorseRef Include="Abstractions.Web.Server">
			<Repo>Asgard</Repo>
		</NorseRef>
		<PackageReference Include="FluentValidation" Version="11.*" />
		<PackageReference Include="Google.Api.CommonProtos" Version="2.*" />
		<PackageReference Include="protobuf-net.Grpc.AspNetCore" Version="1.*" />
	</ItemGroup>
</Project>
