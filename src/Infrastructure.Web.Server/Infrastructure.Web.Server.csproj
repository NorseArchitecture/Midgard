<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<Description>Norse.Infrastructure.Web.Server: gRPC server-side failure encoding. Mediator/Grpc translates Problem into google.rpc.Status + ErrorInfo/BadRequest/DebugInfo well-known types on a grpc-status-details-bin trailer, paired with Infrastructure.Web.Client for symmetrical decoding.</Description>
	</PropertyGroup>
	<ItemGroup>
		<NorseRef Include="Abstractions.Web.Server">
			<Repo>Asgard</Repo>
		</NorseRef>
		<PackageReference Include="FluentValidation" Version="12.*" />
		<PackageReference Include="Google.Api.CommonProtos" Version="2.*" />
		<PackageReference Include="protobuf-net.Grpc.AspNetCore" Version="1.*" />
		<!-- 2026-07-25: the gateway generator's InProcessHost-mode output constructs the four
		     internal Mediator Behavior classes directly from the consuming composition root's own
		     assembly. Grant per consumer, not a blanket public widening — the next composition root
		     that adopts InProcessHost mode needs its own InternalsVisibleTo added here. -->
		<InternalsVisibleTo Include="Norse.Hosting.Web.Server" />
	</ItemGroup>
</Project>
