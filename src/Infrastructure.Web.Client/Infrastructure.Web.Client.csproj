<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Norse.Infrastructure.Web.Client: WASM-friendly gRPC client-side failure decoding. Grpc/ decodes an RpcException's grpc-status-details-bin trailer using google.rpc well-known types and reconstructs a Problem object from the ErrorInfo.Reason, Errors, and CorrelationId details. Bundles the gRPC client registration generator (analyzers/dotnet/cs/), which discovers a compilation's Norse gRPC contracts at compile time and emits AddNorseGrpcClients() — a code-first client proxy per contract over an OutcomeClientInterceptor-decorated invoker, plus idempotent Outcome&lt;T&gt; surrogate wiring and the Norse.Infrastructure.Web.Grpc identifier wire law (CompatibilityLevel 300, 16-byte RFC 9562 identifier bytes fields).</Description>
	</PropertyGroup>
	<ItemGroup>
		<NorseRef Include="Abstractions.Contracts">
			<Repo>Asgard</Repo>
		</NorseRef>
		<PackageReference Include="Google.Api.CommonProtos" Version="2.*" />
		<PackageReference Include="Grpc.Net.Client" Version="2.*" />
		<PackageReference Include="protobuf-net.Grpc" Version="1.*" />
		<ProjectReference
			Include="../../gen/Infrastructure.Web.Client.Generator/Infrastructure.Web.Client.Generator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false" />
		<ProjectReference Include="../Infrastructure.Web.Grpc/Infrastructure.Web.Grpc.csproj" />
	</ItemGroup>
	<Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
		<MSBuild Projects="../../gen/Infrastructure.Web.Client.Generator/Infrastructure.Web.Client.Generator.csproj"
			Targets="Build"
			Properties="Configuration=$(Configuration)" />
		<ItemGroup>
			<None Include="../../gen/Infrastructure.Web.Client.Generator/bin/$(Configuration)/netstandard2.0/Norse.Infrastructure.Web.Client.Generator.dll"
				Pack="true"
				PackagePath="analyzers/dotnet/cs/"
				Visible="false" />
			<None Include="../../gen/Infrastructure.Web.Client.Generator/bin/$(Configuration)/netstandard2.0/Norse.Abstractions.Emit.dll"
				Pack="true"
				PackagePath="analyzers/dotnet/cs/"
				Visible="false" />
		</ItemGroup>
	</Target>
</Project>
