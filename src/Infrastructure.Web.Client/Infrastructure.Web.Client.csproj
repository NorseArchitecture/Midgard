<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Norse.Infrastructure.Web.Client: WASM-friendly gRPC client-side failure decoding. Grpc/ decodes an RpcException's grpc-status-details-bin trailer using google.rpc well-known types and reconstructs a Problem object from the ErrorInfo.Reason, Errors, and CorrelationId details.</Description>
	</PropertyGroup>
	<ItemGroup>
		<NorseRef Include="Abstractions.Contracts">
			<Repo>Asgard</Repo>
		</NorseRef>
		<PackageReference Include="Google.Api.CommonProtos" Version="2.*" />
		<PackageReference Include="protobuf-net.Grpc" Version="1.*" />
	</ItemGroup>
</Project>
