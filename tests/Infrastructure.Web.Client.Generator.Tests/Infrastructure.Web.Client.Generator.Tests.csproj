<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.*" />
		<!-- Standalone WASM-safe Blazor package (mirrors Asgard's Abstractions.Components.csproj),
		     never FrameworkReference Microsoft.AspNetCore.App here: that pulls the whole ASP.NET
		     Core shared framework and trips NU1510 (package pruning) against this project's own
		     explicit Microsoft.Extensions.DependencyInjection/System.Security.Cryptography.Xml
		     references, which the shared framework would otherwise supply implicitly. -->
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.*-*" />
		<PackageReference Include="Grpc.Net.Client" Version="2.*" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="*" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.*-*" />
		<PackageReference Include="protobuf-net" Version="3.*" />
		<PackageReference Include="protobuf-net.Grpc" Version="1.*" />
		<!-- Overrides a known-vulnerable transitive version pulled in by System.ServiceModel.Primitives, mirroring Heimdall's AuthN.Services.csproj. -->
		<PackageReference Include="System.Security.Cryptography.Xml" Version="11.*-*" />
		<PackageReference Include="System.ServiceModel.Primitives" Version="10.*" />
		<ProjectReference Include="../../gen/Infrastructure.Web.Client.Generator/Infrastructure.Web.Client.Generator.csproj" />
		<ProjectReference Include="../../src/Infrastructure.Web.Client/Infrastructure.Web.Client.csproj" />
	</ItemGroup>
</Project>
